# Copy to .env and fill in real values. Never commit .env.

# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/anwarul_huda?schema=public&pgbouncer=true"

# Direct connection, used only by Prisma Migrate.
DIRECT_URL="postgresql://user:password@host:5432/anwarul_huda?schema=public"

# Auth.js secret. Generate with: npx auth secret
AUTH_SECRET="change-me"

# Supabase project URL and secret API key (Settings -> API in the
# Supabase dashboard). The secret key is server only: never expose it to
# the browser, never log it.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_change_me"
